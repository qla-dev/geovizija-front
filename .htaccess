Options -Indexes
DirectoryIndex dist/index.html

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep the deployment endpoint outside the generated Vite build.
    RewriteRule ^redeploy\.php$ - [L]

    # Let the Laravel application's own .htaccess handle API requests (backend lives in ./endpoints).
    RewriteRule ^endpoints(?:/|$) - [L]

    # Link previews: crawlers asking for an article or category get og.php (page-specific
    # Open Graph tags); everyone else gets the app below.
    RewriteRule ^og\.php$ - [L]
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|meta-externalagent|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|discordbot|pinterest|skypeuripreview|viber|applebot|googlebot|bingbot) [NC]
    RewriteRule ^(article|category)/([a-z0-9-]+)/?$ og.php?type=$1&slug=$2 [L,QSA]

    # Prevent repeated rewriting after a request has entered dist.
    RewriteRule ^dist(?:/|$) - [L]

    # Serve generated files and directories from dist.
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
    RewriteRule ^(.+)$ dist/$1 [L]

    # Vite/React client-side routes fall back to the generated index.
    RewriteRule ^$ dist/index.html [L]
    RewriteRule . dist/index.html [L]
</IfModule>
