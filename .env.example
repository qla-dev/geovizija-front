# Which Laravel API the site talks to (see services/api.ts). Copy to .env.local to change it.
#   production -> https://geovizija.com/endpoints/api   (default; works from local `npm run dev` too)
#   local      -> http://127.0.0.1:8000/api             (run `php artisan serve` in ../backend)
VITE_API_BACKEND=production
